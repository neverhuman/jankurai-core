{
  "workspace": "jankurai-core",
  "tests": {
    "crates/jankurai/tests/language_bad_behavior.rs": {
      "command": "cargo test -p jankurai --test language_bad_behavior",
      "purpose": "exercise every language bad-behavior detector fixture"
    },
    "crates/jankurai/tests/fixtures/language_bad_behavior/": {
      "command": "cargo test -p jankurai --test language_bad_behavior",
      "purpose": "exercise the complete language bad-behavior fixture tree"
    },
    "crates/jankurai/tests/fixtures/language_bad_behavior/sql/": {
      "command": "cargo test -p jankurai --test language_bad_behavior",
      "purpose": "exercise SQL detector fixtures"
    },
    "crates/jankurai/tests/fixtures/language_bad_behavior/typescript/": {
      "command": "cargo test -p jankurai --test language_bad_behavior",
      "purpose": "exercise TypeScript detector fixtures"
    },
    "crates/jankurai/tests/fixtures/language_bad_behavior/docker/": {
      "command": "cargo test -p jankurai --test language_bad_behavior",
      "purpose": "exercise container detector fixtures"
    },
    "crates/jankurai/tests/fixtures/language_bad_behavior/python/": {
      "command": "cargo test -p jankurai --test language_bad_behavior",
      "purpose": "exercise Python detector fixtures"
    },
    "crates/jankurai/tests/fixtures/language_bad_behavior/ci/": {
      "command": "cargo test -p jankurai --test language_bad_behavior",
      "purpose": "exercise CI detector fixtures"
    },
    "crates/jankurai/tests/fixtures/language_bad_behavior/git/": {
      "command": "cargo test -p jankurai --test language_bad_behavior",
      "purpose": "exercise Git detector fixtures"
    },
    "crates/jankurai/tests/fixtures/language_bad_behavior/gittools/": {
      "command": "cargo test -p jankurai --test language_bad_behavior",
      "purpose": "exercise Git tooling detector fixtures"
    },
    "crates/jankurai/tests/fixtures/language_bad_behavior/release/": {
      "command": "cargo test -p jankurai --test language_bad_behavior",
      "purpose": "exercise release detector fixtures"
    },
    "db/migrations/": {
      "command": "cargo run -p jankurai -- migrate . --analyze --json target/jankurai/migration-report.json",
      "purpose": "analyze migration safety and liability before merge"
    },
    "tools/security-lane.sh": {
      "command": "bash scripts/ci-local.sh security",
      "purpose": "exercise the fail-closed secret, dependency, workflow, SBOM, and vulnerability lane"
    },
    "crates/": {
      "command": "cargo nextest run --workspace",
      "purpose": "run the Rust workspace test suite for the jankurai crate"
    },
    "Cargo.toml": {
      "command": "cargo check --workspace --locked",
      "purpose": "verify the workspace manifest builds with the locked dependency graph"
    },
    "Cargo.lock": {
      "command": "cargo check --workspace --locked",
      "purpose": "verify the locked dependency graph resolves and stays consistent"
    },
    "Justfile": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify the root command surface lanes are runnable"
    },
    "VERSION": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify the declared crate version stays coherent with release metadata"
    },
    "CHANGELOG.md": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify the changelog tracks released versions"
    },
    "README.md": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify the root readme routes to the workspace layout"
    },
    "LICENSE": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify the license file is present and unmodified"
    },
    "AGENTS.md": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify split-family agent routing remains present"
    },
    "SPLIT.md": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify split metadata stays coherent"
    },
    ".jeryu/": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify local Jeryu and GitHub mirror metadata"
    },
    "agent/": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify split control maps and standard metadata"
    },
    "docs/": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify agent-readable documentation stays present"
    },
    "schemas/": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify schema contracts stay present and valid"
    },
    "ops/": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify pinned CI script entrypoints"
    },
    "scripts/": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify local CI and fusion helpers"
    },
    ".github/": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify CI workflow entrypoints stay pinned and thin"
    },
    "rust-toolchain.toml": {
      "command": "cargo check --workspace --locked",
      "purpose": "verify the pinned toolchain channel and components stay consistent"
    },
    ".gitignore": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "verify the exclusion list keeps transient build paths untracked"
    },
    ".": {
      "command": "bash scripts/ci-local.sh required",
      "purpose": "required local proof for jankurai-core"
    }
  }
}
